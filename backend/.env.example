# ---- REQUIRED ----
# All chat + embedding calls go through the LiteLLM proxy (OpenAI-compatible)
# instead of hitting Gemini directly.
PROXY_API_KEY=your_litellm_proxy_key
PROXY_BASE_URL=https://saidazam-litellm-proxy.hf.space/v1
PROXY_CHAT_MODEL=gemini-flash-lite
PROXY_EMBEDDING_MODEL=gemini-embedding

# Qdrant: leave both blank to use embedded/local Qdrant (no signup, no server).
# Or fill these to use a free cloud.qdrant.io cluster instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=analyst_docs

# ---- OPTIONAL (also free, skip and the app degrades gracefully) ----
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DEEPSEEK_API_KEY=

# ---- App config ----
SQLITE_DB_PATH=./data/company.db
MEMORY_COLLECTION=analyst_memory
CODE_SANDBOX_TIMEOUT_SECONDS=5
SUPERVISOR_STEP_LIMIT=8
CORS_ORIGINS=http://localhost:3000
PORT=8000
